              <Name>Text349</Name>
              <Page isRef="423" />
              <Parent isRef="512" />
              <Text>Bij de aanwezigheid van corrosieve of verontreinigende stoffen moet elektrisch materieel aanvullend zijn beschermd.</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
