            <Text55 Ref="2708" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <CanGrow>True</CanGrow>
              <ClientRectangle>0,1.23,18.7,0.4</ClientRectangle>
              <Conditions isList="true" count="0" />
