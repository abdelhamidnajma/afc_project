              <Name>Text374</Name>
              <Page isRef="423" />
              <Parent isRef="546" />
              <Text>Elektrisch materieel mag geen isolatiefout hebben.</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <Type>Expression</Type>
            </Text374>
            <Text375 Ref="548" type="Text" isKey="true">
              <Border>All;[221:221:221];1;Solid;False;4;Black</Border>
