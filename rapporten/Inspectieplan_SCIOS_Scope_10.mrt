              <Page isRef="595" />
              <Parent isRef="602" />
              <Text>Bepaling omvang te beoordelen partij en steekproef</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <Type>Expression</Type>
            </Text484>
            <Line56 Ref="604" type="Text" isKey="true">
