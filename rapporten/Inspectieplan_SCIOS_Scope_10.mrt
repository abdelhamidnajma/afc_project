            <Text139 Ref="241" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <CanGrow>True</CanGrow>
              <ClientRectangle>0,6.41,18.7,0.72</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Expressions isList="true" count="0" />
              <Font>Century Gothic,8</Font>
              <Guid>f84abd7377334508932f6a1e3d0be376</Guid>
              <Margins>0,0,0,0</Margins>
              <Name>Text139</Name>
              <Page isRef="208" />
              <Parent isRef="222" />
              <Text>Van elke constatering wordt bepaald in welke groep deze valt en in welke vorm deze optreedt. Een constatering kan in meerdere groepen worden ingedeeld. In dat geval is de zwaarste classificatie volgens tabel 1 van toepassing op de constatering.</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <Type>Expression</Type>
            </Text139>
          </Components>
