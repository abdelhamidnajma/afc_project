              <Page isRef="253" />
              <Parent isRef="405" />
              <Text>Veiligheidseisen:</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <Type>Expression</Type>
            </Text279>
            <Text280 Ref="413" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <CanGrow>True</CanGrow>
              <ClientRectangle>9.56,3.53,9.14,0.72</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Expressions isList="true" count="0" />
              <Font>Century Gothic,8</Font>
              <Guid>adc0faa3d05941be8fae1807e9932d83</Guid>
              <Margins>0,0,0,0</Margins>
              <Name>Text280</Name>
              <Page isRef="253" />
              <Parent isRef="405" />
              <Text>Er zijn geen specifieke veiligheidseisen; Werkvergunning, veiligheidsinstructie en dergelijke zijn niet van toepassing.</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <Type>Expression</Type>
            </Text280>
