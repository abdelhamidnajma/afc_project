        <DataBand14 Ref="2405" type="DataBand" isKey="true">
          <Brush>Transparent</Brush>
          <BusinessObjectGuid isNull="true" />
          <ClientRectangle>0,22.79,18.7,4.17</ClientRectangle>
          <Components isList="true" count="5">
            <Line23 Ref="2406" type="Text" isKey="true">
              <Brush>[238:238:238]</Brush>
              <ClientRectangle>0,0,18.7,0.5</ClientRectangle>
              <Conditions isList="true" count="0" />
