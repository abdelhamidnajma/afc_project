              <Margins>8,8,4,2</Margins>
              <Name>Text351</Name>
              <Page isRef="423" />
              <Parent isRef="512" />
              <Text>Aanvullende bescherming kan bestaan uit:
— toepassing aardlekschakelaar; — extra omhulling;
— omhulling onder verhoogde druk.</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
