              <Name>Text275</Name>
              <Page isRef="253" />
              <Parent isRef="405" />
              <Text>Schakelen en scheiden:</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <Type>Expression</Type>
            </Text275>
            <Text276 Ref="409" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <CanGrow>True</CanGrow>
              <ClientRectangle>9.56,1.23,9.14,1.36</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Expressions isList="true" count="0" />
              <Font>Century Gothic,8</Font>
              <Guid>3addc8ad31184b58b9a96768936846de</Guid>
              <Margins>0,0,0,0</Margins>
              <Name>Text276</Name>
              <Page isRef="253" />
              <Parent isRef="405" />
              <Text>De inspecteur zal uitsluitend na overleg met de contactpersoon schakelen en scheiden. Inspecteur en of inspectiebedrijf zijn niet verantwoordelijk voor eventuele gevolgschade tijdens schakelen en scheiden.</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <Type>Expression</Type>
            </Text276>
            <Text277 Ref="410" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <CanGrow>True</CanGrow>
              <ClientRectangle>0,2.7,9.36,0.4</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Expressions isList="true" count="0" />
              <Font>Century Gothic,8</Font>
              <Guid>7814f194a2f64bffb5e7c16f2e2dbf60</Guid>
              <Margins>0,0,0,0</Margins>
              <Name>Text277</Name>
              <Page isRef="253" />
              <Parent isRef="405" />
              <Text>Bereikbaarheid:</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <Type>Expression</Type>
            </Text277>
            <Text278 Ref="411" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <CanGrow>True</CanGrow>
              <ClientRectangle>9.56,2.7,9.14,0.72</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Expressions isList="true" count="0" />
              <Font>Century Gothic,8</Font>
              <Guid>8ad079aef8864f05afd70f9e290d6a5b</Guid>
              <Margins>0,0,0,0</Margins>
              <Name>Text278</Name>
              <Page isRef="253" />
              <Parent isRef="405" />
              <Text>Alle te inspecteren installatiedelen zijn goed bereikbaar en vrij toegankelijk.</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <Type>Expression</Type>
            </Text278>
            <Text279 Ref="412" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <CanGrow>True</CanGrow>
