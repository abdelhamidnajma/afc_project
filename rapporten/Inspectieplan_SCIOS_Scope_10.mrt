            <Text42 Ref="2506" type="Text" isKey="true">
              <AllowHtmlTags>True</AllowHtmlTags>
              <Brush>Transparent</Brush>
              <CanGrow>True</CanGrow>
              <ClientRectangle>0,1.23,18.7,1.04</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Expressions isList="true" count="0" />
              <Font>Microsoft Sans Serif,8</Font>
              <Guid>2d8bfcb6c23248eabca3b1da17158d9a</Guid>
              <Margins>0,0,0,0</Margins>
              <Name>Text42</Name>
              <Page isRef="2499" />
              <Parent isRef="2503" />
              <Text>&lt;b&gt;TD14, §2.2:&lt;/b&gt; De inspectiefrequentie wordt bepaald door gebruik te maken van &lt;b&gt;NTA 8220, §5.3: 'Tabel 3 - Bepaling van de termijn voor de volgende beoordeling, in jaren’&lt;/b&gt; . Als er een overeenkomst bestaat waarin een inspectietermijn is vastgesteld, is deze termijn leidend.</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <Type>Expression</Type>
            </Text42>
            <Text43 Ref="2507" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <CanGrow>True</CanGrow>
              <ClientRectangle>0,2.49,18.7,0.4</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Expressions isList="true" count="0" />
              <Font>Microsoft Sans Serif,8</Font>
              <Guid>6831249df7e44141912e7a05f859dd1a</Guid>
              <Margins>0,0,0,0</Margins>
              <Name>Text43</Name>
              <Page isRef="2499" />
              <Parent isRef="2503" />
              <Text>Voorbeelden van overeenkomsten zijn:</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <Type>Expression</Type>
            </Text43>
            <Text44 Ref="2508" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <CanGrow>True</CanGrow>
              <ClientRectangle>0,3.13,18.7,0.72</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Expressions isList="true" count="0" />
              <Font>Microsoft Sans Serif,8</Font>
              <Guid>01a28ff6f9a74ddfbf6c257b2c67d548</Guid>
              <Margins>0,0,0,0</Margins>
              <Name>Text44</Name>
              <Page isRef="2499" />
              <Parent isRef="2503" />
              <Text>• een verzekeringspolis;
• een huurcontract.</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <Type>Expression</Type>
            </Text44>
            <Text45 Ref="2509" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <CanGrow>True</CanGrow>
              <ClientRectangle>0,4.07,18.7,0.4</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Expressions isList="true" count="0" />
              <Font>Microsoft Sans Serif,8</Font>
              <Guid>4df810ff6d284ef2a21de7559cca551a</Guid>
              <Margins>0,0,0,0</Margins>
              <Name>Text45</Name>
              <Page isRef="2499" />
              <Parent isRef="2503" />
              <Text>De inspectiefrequentie wordt in het inspectierapport bepaald.</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <Type>Expression</Type>
            </Text45>
          </Components>
